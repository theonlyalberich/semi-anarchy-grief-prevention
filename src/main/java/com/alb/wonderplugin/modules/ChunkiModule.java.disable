package com.alb.wonderplugin.modules;

import com.alb.wonderplugin.modules.chunki.commands.ChunkLimitsCommand;
import com.alb.wonderplugin.modules.chunki.commands.ChunkiCommand;
import com.alb.wonderplugin.modules.chunki.listeners.EntityListener;
import com.alb.wonderplugin.modules.chunki.listeners.OptionalComponentListener;
import com.alb.wonderplugin.modules.chunki.listeners.RedstoneComponentListener;
import com.alb.wonderplugin.WonderPlugin;
import com.alb.wonderplugin.api.Module;
import com.alb.wonderplugin.util.ChunkScanner;
import org.bukkit.Bukkit;
import org.bukkit.Chunk;
import org.bukkit.Material;
import org.bukkit.World;
import org.bukkit.configuration.file.FileConfiguration;
import org.bukkit.configuration.file.YamlConfiguration;
import org.bukkit.entity.Entity;
import org.bukkit.event.Listener;

import java.io.File;
import java.io.IOException;
import java.util.Set;

public class ChunkiModule implements Module, Listener {

    private WonderPlugin plugin;
    private FileConfiguration chunkiConfig;
    private File chunkiFile;

    @Override
    public void onEnable(WonderPlugin plugin) {
        this.plugin = plugin;

        // Load chunki.yml
        chunkiFile = new File(plugin.getDataFolder(), "chunki.yml");
        if (!chunkiFile.exists()) {
            plugin.saveResource("chunki.yml", false);
        }
        chunkiConfig = YamlConfiguration.loadConfiguration(chunkiFile);

        // Register listeners (pass chunkiConfig so they use chunki.yml)
        plugin.getServer().getPluginManager().registerEvents(new RedstoneComponentListener(plugin, chunkiConfig), plugin);
        plugin.getServer().getPluginManager().registerEvents(new OptionalComponentListener(plugin, chunkiConfig), plugin);
        plugin.getServer().getPluginManager().registerEvents(new EntityListener(plugin, chunkiConfig), plugin);

        // Admin-only command executor (/chunki set, /chunki remove, /chunki help)
        if (plugin.getCommand("chunki") != null) {
            plugin.getCommand("chunki").setExecutor(new ChunkiCommand(plugin, chunkiConfig, chunkiFile));
        }

        // Public command executor (/chunk limits)
        if (plugin.getCommand("chunk") != null) {
            plugin.getCommand("chunk").setExecutor(new ChunkLimitsCommand(plugin, chunkiConfig));
        }

        // Scheduled cleanup every 30 minutes
        Bukkit.getScheduler().runTaskTimer(plugin, () -> {
            int limit = chunkiConfig.getInt("entity-limits.mobs", -1);
            if (limit == -1) return;

            for (World world : Bukkit.getWorlds()) {
                for (Chunk chunk : world.getLoadedChunks()) {
                    int mobCount = 0;
                    for (Entity e : chunk.getEntities()) {
                        if (EntityListener.isCountedMob(e)) mobCount++;
                    }

                    Set<Material> trackedMaterials = Set.of(
                            Material.REDSTONE_BLOCK,
                            Material.REDSTONE_WIRE,
                            Material.REPEATER,
                            Material.COMPARATOR
                    );
                    int componentCount = ChunkScanner.countComponents(chunk, trackedMaterials);

                    while (mobCount > limit) {
                        Entity toDespawn = EntityListener.findDespawnCandidate(chunk);
                        if (toDespawn != null) {
                            toDespawn.remove();
                            mobCount--;
                        } else break;
                    }

                    if (componentCount > chunkiConfig.getInt("entity-limits.components", Integer.MAX_VALUE)) {
                        plugin.getLogger().warning("Chunk at " + chunk.getX() + "," + chunk.getZ() +
                                " in world " + world.getName() + " has " + componentCount + " tracked components.");
                    }
                }
            }
        }, 20L, 20L * 60 * 30);
    }

    @Override
    public void onDisable() {
        try {
            chunkiConfig.save(chunkiFile);
        } catch (IOException e) {
            plugin.getLogger().severe("Failed to save chunki.yml: " + e.getMessage());
        }
    }

    @Override
    public String getName() {
        return "Chunki";
    }
}
